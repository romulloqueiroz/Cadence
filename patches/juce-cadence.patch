+    template <typename Type>
+    static void appendStateFrom (XmlElement& head, VSTComSmartPtr<Type>& object, const String& identifier)
+    {
+        if (object != nullptr)
+        {
+            MemoryStream stream;
+
+            const auto result = object->getState (&stream);
+
+            if (result == kResultTrue)
+            {
