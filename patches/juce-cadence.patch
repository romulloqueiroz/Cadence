-        if (settings != nullptr)
-            f = File (settings->getValue ("lastStateFile"));
-
-        if (f == File())
-            f = File::getSpecialLocation (File::userDocumentsDirectory);
-
-        return f;
-    }
-
-    void setLastFile (const FileChooser& fc)
