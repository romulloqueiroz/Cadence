+   #if CADENCE_NATIVE_AUTOMATION
+    bool queueNativeParameter (int parameterIndex, int sampleOffset, float normalized) noexcept override
+    {
+        const auto& parameters = getParameters();
+        if (parameterIndex < 0 || parameterIndex >= parameters.size() || sampleOffset < 0)
+            return false;
+        auto* parameter = dynamic_cast<VST3Parameter*> (parameters[parameterIndex]);
+        if (parameter == nullptr || pendingNativeCount >= (int) pendingNative.size())
+            return false;
+        pendingNative[(size_t) pendingNativeCount++] = { parameter->getParamID(), normalized, sampleOffset };
+        return true;
+    }
+
+    bool queueNativeParameterRamp (int parameterIndex, int start, int duration,
+                                   float from, float to) noexcept override
+    {
+        if (duration <= 0 || ! queueNativeParameter (parameterIndex, start, from))
+            return false;
+        return queueNativeParameter (parameterIndex, start + duration, to);
+    }
+
+    void setNativeParameterValue (int parameterIndex, float normalized) noexcept override
+    {
+        const auto& parameters = getParameters();
+        if (parameterIndex < 0 || parameterIndex >= parameters.size())
+            return;
+        if (auto* parameter = dynamic_cast<VST3Parameter*> (parameters[parameterIndex]))
+            parameter->setValueWithoutUpdatingProcessor (normalized);
+    }
