-class StandaloneFilterWindow    : public DocumentWindow,
-                                  private Button::Listener
-{
-public:
-    //==============================================================================
-    typedef StandalonePluginHolder::PluginInOuts PluginInOuts;
-
-    StandaloneFilterWindow (const String& title,
