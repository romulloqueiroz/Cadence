-                if (component->getBusInfo (Vst::kAudio, dir, (Steinberg::int32) i, info) != kResultOk)
-                    continue;
-
-                AudioChannelSet layout = (info.channelCount == 0 ? AudioChannelSet::disabled()
-                                                                 : AudioChannelSet::discreteChannels (info.channelCount));
