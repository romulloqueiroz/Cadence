-static void toProcessContext (Vst::ProcessContext& context,
-                              AudioPlayHead* playHead,
-                              double sampleRate)
-{
-    jassert (sampleRate > 0.0); //Must always be valid, as stated by the VST3 SDK
-
-    using namespace Vst;
-
-    zerostruct (context);
