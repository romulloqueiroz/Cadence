+//==============================================================================
+static inline void recursiveFileSearch (VST3PluginFormatHeadless& format, StringArray& results, const File& directory, const bool recursive)
+{
+    for (const auto& iter : RangedDirectoryIterator (directory, false, "*", File::findFilesAndDirectories))
+    {
+        auto f = iter.getFile();
+        bool isPlugin = false;
+
+        if (format.fileMightContainThisPluginType (f.getFullPathName()))
+        {
+            isPlugin = true;
+            results.add (f.getFullPathName());
+        }
+
+        if (recursive && (! isPlugin) && f.isDirectory())
+            recursiveFileSearch (format, results, f, true);
+    }
+}
+
+static StringArray getLibraryPaths ([[maybe_unused]] VST3PluginFormatHeadless& format, const String& fileOrIdentifier)
+{
+   #if JUCE_WINDOWS
+    if (! File (fileOrIdentifier).existsAsFile())
+    {
+        StringArray files;
+        recursiveFileSearch (format, files, fileOrIdentifier, true);
+        return files;
+    }
+   #endif
+
+    return { fileOrIdentifier };
+}
+
+template <typename TypeToCreate>
+static std::unique_ptr<AudioPluginInstance> createVST3Instance (VST3PluginFormatHeadless& format,
+                                                                const PluginDescription& description,
+                                                                const File& file,
+                                                                VSTComSmartPtr<VST3HostContextHeadless> host)
+{
+    if (! format.fileMightContainThisPluginType (description.fileOrIdentifier))
+        return nullptr;
+
+    struct ScopedWorkingDirectory
+    {
+        ~ScopedWorkingDirectory() { previousWorkingDirectory.setAsCurrentWorkingDirectory(); }
+        File previousWorkingDirectory = File::getCurrentWorkingDirectory();
+    };
+
+    const ScopedWorkingDirectory scope;
+    file.getParentDirectory().setAsCurrentWorkingDirectory();
+
+    const auto module = VST3ModuleHandle::create (file, description);
+
+    if (! module.isValid())
+        return nullptr;
+
+    auto holder = std::make_unique<VST3ComponentHolder> (module, host);
+
+    if (! holder->initialise())
+        return nullptr;
+
+    auto instance = std::make_unique<TypeToCreate> (std::move (holder));
+
+    if (! instance->initialise())
+        return nullptr;
+
+    return instance;
+}
+
+template <typename TypeToCreate>
+static void createVst3InstanceImpl (VST3PluginFormatHeadless& format,
+                                    VSTComSmartPtr<VST3HostContextHeadless> host,
+                                    const PluginDescription& description,
+                                    AudioPluginFormat::PluginCreationCallback callback)
+{
+    for (const auto& file : getLibraryPaths (format, description.fileOrIdentifier))
+    {
+        if (auto result = createVST3Instance<TypeToCreate> (format, description, file, host))
+        {
+            callback (std::move (result), {});
+            return;
+        }
+    }
+
+    callback (nullptr, TRANS ("Unable to load XXX plug-in file").replace ("XXX", "VST-3"));
+}
+
+JUCE_END_NO_SANITIZE
+
+} // namespace juce
+
+#endif
